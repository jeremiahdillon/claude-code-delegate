#!/usr/bin/env python3
"""review-loop — automated builder/reviewer adversarial review cycles.

Claude Code is the builder. The reviewer is a cheaper model from another lab,
run one round at a time through delegate-agent (fresh session per round, plan
mode, output captured to iter-NN/review.md). Every hand-over is a git commit.
It reviews code, plans, and other work (writing, analysis, calculations,
research) through combinable review lenses.

  review-loop new <cycle> [--target PATH …] [--ref PATH …] [--lenses a,b]
                  [--setup auto|in-place|init|workspace] [--workspace-root DIR] [--force]
                                               scaffold the cycle; with --target, choose how the
                                               work gets into git (prints ROOT: for later --repo)
  review-loop init <cycle> [--reviewer M] [--max N] [--budget USD] [--trailer T]
                                               open the cycle (BRIEF.md filled in, tree clean)
  review-loop review [--model M]               run one reviewer round; validate; commit
  review-loop respond --decision continue|close [--override REASON] [--trailer T]
                                               validate response.md (and CLOSE.md); commit the fixes
  review-loop status | ledger | changes [--iteration N] | list | lenses
  review-loop adjust [--budget USD] [--max N] [--model M]   change an open cycle's limits (with user approval)
  review-loop apply [--yes] [--include-new] [--include-deletes]
                                               workspace cycles: copy changes back to the originals

Global: --repo PATH (default: the git repo containing cwd), --review-dir DIR, --cycle C.
Exit codes follow delegate-*: 0 ok, 1 failure, 2 usage/state, 3 refused,
4 credits, 5 auth, 6 upstream, 7 timeout, 8 budget/cap, 9 review format invalid.
Docs: ~/.claude/skills/adversarial-review/SKILL.md
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

HOME_DIR = Path(__file__).resolve().parent.parent          # the review-loop/ directory
TEMPLATES = HOME_DIR / "templates"
LENS_DIR = TEMPLATES / "lenses"
DEFAULTS = HOME_DIR / "defaults.json"
DIR_CANDIDATES = ("_review", ".review", ".delegate/review")

SEVERITIES = ("blocker", "major", "minor", "nit")
VERDICTS = ("ACCEPT", "REJECT", "PARTIAL", "BACKLOG")
SUMMARY_VERDICTS = ("ACCEPT", "PARTIAL", "REJECT", "BACKLOG")   # the order the round summary prints
V_STATUSES = ("verified", "not-fixed", "regressed", "partially-fixed")
OUTCOMES = ("converged", "cap-reached", "budget-reached", "aborted")
SETUPS = ("in-place", "init", "workspace")
LEGACY_TYPE = {"code": "code", "plan": "plan", "other": "general"}
PROJECT_MANIFESTS = ("package.json", "pyproject.toml", "setup.py", "Cargo.toml", "go.mod",
                     "Makefile", "pom.xml", "build.gradle", "Gemfile", "composer.json", "CMakeLists.txt")
COPY_SKIP = {".git", "node_modules", ".venv", "__pycache__", ".DS_Store", ".opencode", ".delegate"}
SUMMARY_START, SUMMARY_END = "<!-- round-summary:start -->", "<!-- round-summary:end -->"

F_HDR = re.compile(r"^### (F-(\d{2})-\d{2}) · (blocker|major|minor|nit) · ([a-z][a-z-]*)\s*$", re.M)
C_HDR = re.compile(r"^### (C-(\d{2})-\d{2}) · re (F-\d{2}-\d{2})\s*$", re.M)
V_HDR = re.compile(r"^### (V-(\d{2})-\d{2}) · (F-\d{2}-\d{2}) · (verified|not-fixed|regressed|partially-fixed)\s*$", re.M)
R_HDR = re.compile(r"^### ([FC]-\d{2}-\d{2}) · (ACCEPT|REJECT|PARTIAL|BACKLOG)\s*$", re.M)
REC = re.compile(r"^## Recommendation: (continue|converge)\s*$", re.M)
OUTCOME = re.compile(r"^Outcome: (converged|cap-reached|budget-reached|aborted)\s*$", re.M)
LENSES_LINE = re.compile(r"^\*\*Lenses:\*\*[ \t]*(.*)$", re.M)
TYPE_LINE = re.compile(r"^\*\*Type:\*\*\s*(code|plan|other)\b", re.M)
REQUIRED_BRIEF = ("what you are reviewing", "in scope", "out of scope", "intent",
                  "settled", "forward", "checks", "checklist")

EXIT_MEANING = {1: "unexpected failure", 2: "usage", 3: "refused", 4: "out of credits / key limit",
                5: "bad or missing API key", 6: "provider error or rate limit",
                7: "reviewer timed out", 8: "over budget", 130: "interrupted"}


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg: str, code: int = 2):
    print(f"ERROR: {msg}")
    sys.exit(code)


def run_git(cwd, *args, check=False) -> subprocess.CompletedProcess:
    r = subprocess.run(["git", *args], cwd=str(cwd), capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)} failed in {cwd}: {r.stderr.strip()}", 1)
    return r


def load_defaults() -> dict:
    return json.loads(DEFAULTS.read_text())


# ---------------------------------------------------------------- delegate lib (extract, deny list)

_DLIB = None


def delegate_lib():
    """(extract module, delegate_common module) or None.

    Found through delegate-extract on PATH (resolved through symlinks, then
    ../lib), else the published repo's sibling delegate/lib."""
    global _DLIB
    if _DLIB is None:
        cands = []
        w = shutil.which("delegate-extract")
        if w:
            cands.append(Path(w).resolve().parent.parent / "lib")
        cands.append(HOME_DIR.parent / "delegate" / "lib")
        _DLIB = False
        for c in cands:
            if (c / "extract.py").exists():
                sys.path.insert(0, str(c))
                try:
                    import delegate_common  # noqa: F401
                    import extract
                    _DLIB = (extract, delegate_common)
                except ImportError:
                    _DLIB = False
                break
    return _DLIB or None


def deny_match(p: Path):
    lib = delegate_lib()
    return lib[1].denied(p) if lib else None


# ---------------------------------------------------------------- context

class Ctx:
    def __init__(self, a, root: Path | None = None):
        if root is None:
            start = Path(a.repo).expanduser().resolve() if a.repo else Path.cwd()
            r = run_git(start, "rev-parse", "--show-toplevel")
            if r.returncode != 0:
                die(f"{start} is not in a git repository. review-loop commits every hand-over; "
                    "pass --target to `new` to choose a setup, or ask the user whether to `git init` it", 3)
            root = Path(r.stdout.strip())
        self.root = Path(root).resolve()
        self.defaults = load_defaults()
        self.rdir = self._find_dir(a.review_dir)
        cfg_path = self.rdir / "config.json"
        self.cfg = dict(self.defaults)
        if cfg_path.exists():
            self.cfg.update(json.loads(cfg_path.read_text()))
        self.cycles = self.rdir / "cycles"
        self.current = self.rdir / "CURRENT"
        self.trailer = getattr(a, "trailer", None)

    def _find_dir(self, explicit):
        if explicit:
            return (self.root / explicit).resolve()
        for cand in (self.defaults["review_dir"],) + DIR_CANDIDATES:
            if (self.root / cand / "config.json").exists():
                return self.root / cand
        return self.root / self.defaults["review_dir"]

    def rel(self, p: Path) -> str:
        return str(p.resolve().relative_to(self.root))

    # git
    def git(self, *args, check=True):
        r = subprocess.run(["git", *args], cwd=self.root, capture_output=True, text=True)
        if check and r.returncode != 0:
            die(f"git {' '.join(args)} failed: {r.stderr.strip()}", 1)
        return r.stdout

    def ignored(self, path: str) -> bool:
        return run_git(self.root, "check-ignore", "-q", path).returncode == 0

    def dirty_outside(self, prefix: str) -> list:
        out = self.git("status", "--porcelain", "--untracked-files=all")
        bad = []
        for line in out.splitlines():
            p = line[3:].split(" -> ")[-1].strip('"')
            if p.startswith(prefix) or p.startswith((".opencode/", ".delegate/")):
                continue
            bad.append(p)
        return bad

    def commit(self, add: list, message: str):
        if add:
            # git refuses to add an ignored path (e.g. --review-dir .delegate/review);
            # such records simply stay out of the commit.
            keep = [p for p in add if not self.ignored(p)]
            if keep:
                self.git("add", "-A", *keep)
        else:
            self.git("add", "-A")
        msg = message + (f"\n\n{self.trailer}" if self.trailer else "")
        r = subprocess.run(["git", "commit", "-q", "--allow-empty", "-m", msg], cwd=self.root,
                           capture_output=True, text=True)
        if r.returncode != 0:
            return (r.stderr or r.stdout).strip()
        return None

    def head(self) -> str:
        return self.git("rev-parse", "HEAD").strip()

    def diff_excludes(self) -> list:
        """Pathspecs for builder diffs: everything but the cycle records (extracts stay in)."""
        rd = self.rel(self.rdir)
        return ["--", ".", f":(exclude){rd}/cycles", f":(exclude){rd}/CURRENT"]

    # cycles
    def cycle_name(self, name):
        name = name or (self.current.read_text().strip() if self.current.exists() else "")
        if not name:
            die("no cycle given and none is current (review-loop list)")
        return name

    def cdir(self, c): return self.cycles / c
    def idir(self, c, n): return self.cdir(c) / f"iter-{n:02d}"

    def load(self, c):
        sp = self.cdir(c) / "STATE.json"
        if not sp.exists():
            die(f"cycle {c!r} is not open (write its BRIEF.md, then review-loop init {c})")
        return json.loads(sp.read_text())

    def save(self, c, s):
        s["updated_at"] = now()
        sp = self.cdir(c) / "STATE.json"
        tmp = sp.with_suffix(".tmp")
        tmp.write_text(json.dumps(s, indent=2) + "\n")
        os.replace(tmp, sp)


def usd(x: float) -> str:
    return f"${x:.2f}" if x >= 0.1 or x == 0 else f"${x:.3f}"


def has_todo(text: str) -> bool:
    return bool(re.search(r"\bTODO\b", re.sub(r"<!--.*?-->", "", text, flags=re.S)))


def ensure_excluded(root: Path, entries) -> None:
    """Add entries to <root>/.git/info/exclude if missing."""
    excl = root / ".git" / "info" / "exclude"
    try:
        cur = excl.read_text() if excl.exists() else ""
        have = set(cur.split())
        add = [e for e in entries if e not in have]
        if add:
            excl.parent.mkdir(parents=True, exist_ok=True)
            with excl.open("a") as f:
                f.write(("" if cur.endswith("\n") or not cur else "\n") + "\n".join(add) + "\n")
    except OSError:
        pass


def ensure_identity(root: Path) -> None:
    """A local fallback identity, only if git has none configured."""
    if not run_git(root, "config", "user.email").stdout.strip():
        run_git(root, "config", "user.email", "review-loop@localhost", check=True)
    if not run_git(root, "config", "user.name").stdout.strip():
        run_git(root, "config", "user.name", "review-loop", check=True)


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# ---------------------------------------------------------------- lenses

def available_lenses(rdir: Path | None) -> list:
    names = {p.stem for p in LENS_DIR.glob("*.md")}
    if rdir is not None and (rdir / "lenses").is_dir():
        names |= {p.stem for p in (rdir / "lenses").glob("*.md")}
    return sorted(names)


def load_lens(name: str, rdir: Path | None):
    """-> (categories, body) or None. Project lenses override shipped ones."""
    for d in ([rdir / "lenses"] if rdir is not None else []) + [LENS_DIR]:
        p = d / f"{name}.md"
        if p.exists():
            text = p.read_text()
            cats, body = [], text
            m = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.S)
            if m:
                body = text[m.end():]
                cm = re.search(r"^categories:[ \t]*(.*)$", m.group(1), re.M)
                if cm:
                    cats = [c.strip() for c in cm.group(1).split(",") if c.strip()]
            return cats, body.strip()
    return None


def parse_lens_list(value: str) -> list:
    return [x.strip() for x in re.split(r"[,\s]+", value or "") if x.strip()]


def brief_lenses(brief: str):
    """-> (lenses, legacy) from a brief; (None, None) if it declares neither form."""
    m = LENSES_LINE.search(brief)
    if m and parse_lens_list(m.group(1)) and not has_todo(m.group(1)):
        return parse_lens_list(m.group(1)), False
    t = TYPE_LINE.search(brief)
    if t:
        return [LEGACY_TYPE[t.group(1)]], True
    return None, None


def compute_categories(lenses: list, legacy: bool, rdir: Path, cfg: dict) -> list:
    base = list(cfg["categories"]) if legacy else list(cfg.get("core_categories")
                                                        or load_defaults()["core_categories"])
    for name in lenses:
        lens = load_lens(name, rdir)
        base += lens[0] if lens else []
    out = []
    for c in base:
        if c not in out:
            out.append(c)
    return out


def cycle_categories(ctx: Ctx, s: dict) -> list:
    return s.get("categories") or ctx.cfg["categories"]


def cycle_lenses(ctx: Ctx, s: dict) -> list:
    if s.get("lenses"):
        return s["lenses"]
    lenses, _ = brief_lenses(read(ctx.cdir(s["cycle"]) / "BRIEF.md"))   # cycles opened before lenses
    return lenses or ["general"]


# ---------------------------------------------------------------- parsing + ledger

def finding_title(text: str, fid: str) -> str:
    m = re.search(rf"^### {re.escape(fid)} .*?$(.*?)(?=^### |^## |\Z)", text, re.M | re.S)
    if not m:
        return ""
    fm = re.search(r"\*\*Finding:\*\*\s*(.+)", m.group(1))
    t = (fm.group(1) if fm else m.group(1).strip().split("\n")[0]).strip()
    return (t[:110] + "…") if len(t) > 110 else t


def read(p: Path) -> str:
    return p.read_text() if p.exists() else ""


def ledger(ctx: Ctx, c: str, upto: int) -> dict:
    """Replay reviews and responses 1..upto into per-finding status.

    Status: open (new, no verdict yet) · fix-pending (ACCEPT/PARTIAL, awaiting
    verification) · verified · reopened (V said not fixed) · challenged ·
    rejected · backlog · disputed (rejected again after a challenge).
    """
    fs = {}
    for n in range(1, upto + 1):
        rv = read(ctx.idir(c, n) / "review.md")
        for fid, _it, sev, cat in F_HDR.findall(rv):
            fs[fid] = {"id": fid, "sev": sev, "cat": cat, "iter": n, "status": "open",
                       "title": finding_title(rv, fid), "last_verdict": None}
        for _vid, _it, ref, st in V_HDR.findall(rv):
            if ref in fs:
                fs[ref]["status"] = "verified" if st == "verified" else "reopened"
                fs[ref]["v"] = st
        challenged = {}
        for cid, _it, ref in C_HDR.findall(rv):
            if ref in fs:
                fs[ref]["status"] = "challenged"
                challenged[cid] = ref
        rs = read(ctx.idir(c, n) / "response.md")
        for rid, verdict in R_HDR.findall(rs):
            ref = challenged.get(rid, rid)
            if ref not in fs:
                continue
            f = fs[ref]
            f["last_verdict"] = verdict
            if verdict in ("ACCEPT", "PARTIAL"):
                f["status"] = "fix-pending"
            elif verdict == "BACKLOG":
                f["status"] = "backlog"
            elif verdict == "REJECT":
                f["status"] = "disputed" if rid.startswith("C-") else "rejected"
    return fs


def validate_review(text: str, n: int, must_verify: set, categories: list):
    problems = []
    rec = REC.search(text)
    if not rec:
        problems.append("missing the final line '## Recommendation: continue' or '## Recommendation: converge'")
    if not re.search(r"^# Review\b", text, re.M):
        problems.append("missing the '# Review — <cycle> — iteration NN' title")
    if "## Summary" not in text:
        problems.append("missing '## Summary'")
    if "## New findings" not in text:
        problems.append("missing '## New findings' (write 'None.' under it if there are none)")
    fs, cs, vs = F_HDR.findall(text), C_HDR.findall(text), V_HDR.findall(text)
    for fid, it, _sev, cat in fs:
        if int(it) != n:
            problems.append(f"{fid}: findings in iteration {n} must be numbered F-{n:02d}-NN")
        if cat not in categories:
            problems.append(f"{fid}: category '{cat}' is not one of: {', '.join(categories)}")
    for cid, it, _ref in cs:
        if int(it) != n:
            problems.append(f"{cid}: challenges in iteration {n} must be numbered C-{n:02d}-NN")
    for vid, it, _ref, _st in vs:
        if int(it) != n:
            problems.append(f"{vid}: verifications in iteration {n} must be numbered V-{n:02d}-NN")
    ids = [f[0] for f in fs] + [x[0] for x in cs] + [v[0] for v in vs]
    if len(ids) != len(set(ids)):
        problems.append("duplicate F-/C-/V- IDs")
    if must_verify:
        if "## Verification of previous fixes" not in text:
            problems.append("missing '## Verification of previous fixes'")
        missing = sorted(must_verify - {v[2] for v in vs})
        if missing:
            problems.append("no V- item for: " + ", ".join(missing))
    loose = [l for l in re.findall(r"^### .*$", text, re.M)
             if not (F_HDR.match(l) or C_HDR.match(l) or V_HDR.match(l))]
    if loose:
        problems.append("### headings not in a required form: " + "; ".join(loose[:5]))
    return problems, fs, cs, vs, (rec.group(1) if rec else None)


# ---------------------------------------------------------------- round summary

def round_summary(s: dict) -> str:
    """Markdown table: per iteration, findings by severity, fixes verified,
    builder verdicts, the reviewer's recommendation and the cost (failed
    attempts included)."""
    iters = sorted({h["iteration"] for h in s["history"] if h["event"] in ("review", "review-failed")})
    if not iters:
        return "No reviewer rounds ran."
    rows = ["| Round | Blocker | Major | Minor | Nit | Fixes verified | Builder: accept / partial / reject / backlog "
            "| Recommendation | Cost |", "|---|---|---|---|---|---|---|---|---|"]
    tot = {k: 0 for k in SEVERITIES}
    tv = tvn = 0
    tverd = {v: 0 for v in VERDICTS}
    tcost, failed = 0.0, 0
    for n in iters:
        evs = [h for h in s["history"] if h.get("iteration") == n]
        cost = sum(h.get("cost_usd") or 0 for h in evs if h["event"] in ("review", "review-failed"))
        nfail = sum(1 for h in evs if h["event"] == "review-failed")
        failed += nfail
        tcost += cost
        rv = [h for h in evs if h["event"] == "review"]
        if rv:
            r = rv[-1]
            counts = r.get("counts", {})
            vc = r.get("verifications", {})
            nv, nall = vc.get("verified", 0), sum(vc.values())
            tv, tvn = tv + nv, tvn + nall
            ver = f"{nv} of {nall}" if nall else "—"
            rec = r.get("recommendation") or "—"
            for k in SEVERITIES:
                tot[k] += counts.get(k, 0)
            sev = [str(counts.get(k, 0)) for k in SEVERITIES]
        else:
            sev, ver, rec = ["—"] * 4, "—", "(failed)"
        resp = [h for h in evs if h["event"] == "response"]
        if resp:
            vd = resp[-1].get("verdicts", {})
            for k in VERDICTS:
                tverd[k] += vd.get(k, 0)
            verd = " / ".join(str(vd.get(k, 0)) for k in SUMMARY_VERDICTS)
        else:
            verd = "—"
        note = f" ({nfail} failed attempt{'s' if nfail != 1 else ''})" if nfail else ""
        rows.append(f"| {n} | " + " | ".join(sev) + f" | {ver} | {verd} | {rec} | ${cost:.4f}{note} |")
    rows.append("| **Total** | " + " | ".join(f"**{tot[k]}**" for k in SEVERITIES)
                + f" | **{tv} of {tvn}** | **" + " / ".join(str(tverd[k]) for k in SUMMARY_VERDICTS)
                + f"** | | **${tcost:.4f}** |")
    out = "\n".join(rows)
    if failed:
        out += f"\n\nCosts include {failed} failed reviewer attempt(s)."
    return out


def write_round_summary(cp: Path, s: dict):
    block = f"{SUMMARY_START}\n## Round summary\n\n{round_summary(s)}\n{SUMMARY_END}"
    text = read(cp)
    if SUMMARY_START in text and SUMMARY_END in text:
        text = re.sub(re.escape(SUMMARY_START) + r".*?" + re.escape(SUMMARY_END), lambda _m: block, text, flags=re.S)
    else:
        text = text.rstrip() + "\n\n" + block + "\n"
    cp.write_text(text)


# ---------------------------------------------------------------- setup decision (new --target)

def git_top(p: Path):
    d = p if p.is_dir() else p.parent
    r = run_git(d, "rev-parse", "--show-toplevel")
    return Path(r.stdout.strip()).resolve() if r.returncode == 0 else None


def is_ignored(top: Path, p: Path) -> bool:
    return run_git(top, "check-ignore", "-q", str(p)).returncode == 0


def tree_dirty(top: Path) -> list:
    r = run_git(top, "status", "--porcelain", "--untracked-files=all")
    out = []
    for line in r.stdout.splitlines():
        p = line[3:].split(" -> ")[-1].strip('"')
        if p.startswith(tuple(c + "/" for c in DIR_CANDIDATES) + (".opencode/", ".delegate/")):
            continue
        out.append(p)
    return out


def row5_eligible(targets: list) -> bool:
    return (len(targets) == 1 and targets[0].is_dir()
            and any((targets[0] / m).exists() for m in PROJECT_MANIFESTS))


def decide(targets: list, lenses: list) -> dict:
    """§5.2 of the plan: -> {row, setup, ask, reason, top}"""
    tops = [git_top(t) for t in targets]
    for t, top in zip(targets, tops):
        if top and is_ignored(top, t):
            return {"row": 1, "setup": "workspace", "ask": False, "top": None,
                    "reason": f"{t} is git-ignored in {top}, so its changes would never show in git"}
    uniq = set(tops)
    if len(uniq) > 1:
        return {"row": 2, "setup": "workspace", "ask": True, "top": None,
                "reason": "the targets span several repositories or mix git and non-git paths"}
    top = tops[0]
    if top:
        dirty = tree_dirty(top)
        if not dirty:
            return {"row": 3, "setup": "in-place", "ask": False, "top": top,
                    "reason": f"the targets are tracked in {top}, and its working tree is clean"}
        return {"row": 4, "setup": "in-place", "ask": True, "top": top,
                "reason": f"{top} has {len(dirty)} uncommitted change(s) (e.g. {', '.join(dirty[:3])}); "
                          "the user's work must be committed first, or use a workspace copy"}
    if row5_eligible(targets) and set(lenses) & {"code", "plan"}:
        return {"row": 5, "setup": "init", "ask": True, "top": None,
                "reason": f"{targets[0]} is not in git but looks like a project; `git init` there "
                          "would change the user's folder"}
    return {"row": 6, "setup": "workspace", "ask": False, "top": None,
            "reason": "the targets are not in git; they will be copied into a workspace repo"}


def unique_name(taken: set, base: str) -> str:
    stem, ext = os.path.splitext(base)
    if base.startswith(".") and not ext:
        stem, ext = base, ""
    name, k = base, 2
    while name in taken:
        name, k = f"{stem}-{k}{ext}", k + 1
    taken.add(name)
    return name


def copy_input(src: Path, dest: Path, files: dict, rel_prefix: str, skipped: list):
    """Copy a file or directory tree, skipping COPY_SKIP and deny-listed files.
    Records {in-tree relative path: {original, sha256}} in files."""
    if src.is_file():
        if deny_match(src):
            skipped.append(f"{src} (deny list)")
            return
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
        files[rel_prefix] = {"original": str(src), "sha256": sha256(dest)}
        return
    for dp, dns, fns in os.walk(src):
        dns[:] = [d for d in dns if d not in COPY_SKIP]
        for fn in fns:
            s = Path(dp) / fn
            rel = s.relative_to(src)
            if fn in COPY_SKIP or s.is_symlink():
                if s.is_symlink():
                    skipped.append(f"{s} (symlink)")
                continue
            if deny_match(s):
                skipped.append(f"{s} (deny list)")
                continue
            d = dest / rel
            d.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(s, d)
            files[f"{rel_prefix}/{rel.as_posix()}"] = {"original": str(s), "sha256": sha256(d)}


def tree_bytes(paths: list) -> int:
    total = 0
    for p in paths:
        if p.is_file():
            total += p.stat().st_size
            continue
        for dp, dns, fns in os.walk(p):
            dns[:] = [d for d in dns if d not in COPY_SKIP]
            total += sum((Path(dp) / f).stat().st_size for f in fns
                         if f not in COPY_SKIP and not (Path(dp) / f).is_symlink())
    return total


def make_workspace(a, cycle: str, targets: list, refs: list, defaults: dict) -> tuple:
    """-> (workspace root, target in-tree paths, ref in-tree paths, mapping)"""
    root_dir = Path(a.workspace_root or defaults["workspace_root"]).expanduser()
    h = hashlib.sha256("\n".join(sorted(str(p) for p in targets + refs)).encode()).hexdigest()[:8]
    ws = root_dir / f"{cycle}-{h}"
    if ws.exists():
        die(f"workspace {ws} already exists; it is never reused or overwritten. Pick another cycle "
            "name, or remove it after checking nothing in it is needed", 2)
    size = tree_bytes(targets + refs)
    cap = defaults.get("workspace_max_mb", 200)
    if size > cap * 1024 * 1024 and not a.force:
        die(f"the inputs total {size / 1048576:.0f} MB, over workspace_max_mb ({cap}); the copy is "
            "committed to git. Narrow the targets, or pass --force with the user's approval", 3)
    ws.mkdir(parents=True)
    run_git(ws, "init", "-q", check=True)
    ensure_identity(ws)
    ensure_excluded(ws, [".opencode/", ".delegate/"])
    files, skipped, mapping = {}, [], []
    tin, rin = [], []
    for role, items, sub, acc in (("target", targets, "work", tin), ("ref", refs, "ref", rin)):
        taken = set()
        for p in items:
            name = unique_name(taken, p.name)
            rel = f"{sub}/{name}"
            copy_input(p, ws / rel, files, rel, skipped)
            acc.append(rel)
            mapping.append({"role": role, "original": str(p), "in_tree": rel,
                            "kind": "dir" if p.is_dir() else "file"})
    (ws / "SOURCES.json").write_text(json.dumps(
        {"copied_at": now(), "inputs": mapping, "files": files}, indent=2) + "\n")
    run_git(ws, "add", "-A", check=True)
    run_git(ws, "commit", "-q", "-m", f"review({cycle}): workspace snapshot", check=True)
    if skipped:
        print(f"SKIPPED {len(skipped)} file(s) while copying:")
        for x in skipped[:30]:
            print(f"  {x}")
    return ws, tin, rin, mapping


def init_in_place(target: Path, cycle: str):
    run_git(target, "init", "-q", check=True)
    ensure_identity(target)
    denied = []
    for dp, dns, fns in os.walk(target):
        dns[:] = [d for d in dns if d != ".git"]
        for fn in fns:
            p = Path(dp) / fn
            if deny_match(p):
                denied.append(p.relative_to(target).as_posix())
    ensure_excluded(target, [".opencode/", ".delegate/"] + ["/" + d for d in denied])
    if denied:
        print(f"EXCLUDED from git (deny list): {', '.join(denied[:20])}")
    run_git(target, "add", "-A", check=True)
    run_git(target, "commit", "-q", "-m", f"review({cycle}): initial snapshot", check=True)


def cmd_new(a):
    c = a.cycle
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,60}", c):
        die("cycle names: lowercase letters, digits, '.', '_', '-' (e.g. 2026-09-26-auth-refactor)")
    targets = [Path(t).expanduser().resolve() for t in a.target or []]
    refs = [Path(t).expanduser().resolve() for t in a.ref or []]
    for p in targets + refs:
        if not p.exists():
            die(f"no such file or directory: {p}")
    lenses = parse_lens_list(a.lenses) if a.lenses else []
    unknown = [x for x in lenses if x not in available_lenses(None) and not load_lens(x, None)]
    setup_rec = {"setup": "in-place", "row": None, "lenses": lenses, "row5_eligible": False,
                 "inputs": {"targets": [str(p) for p in targets], "refs": [str(p) for p in refs]}}
    mapping = []
    if not targets:
        if a.setup not in ("auto", "in-place"):
            die("--setup needs --target (without --target the cycle reviews the current repo in place)")
        ctx = Ctx(a)
        tin = []
    else:
        if not lenses and a.setup == "auto":
            die("--lenses is required with --target: the setup decision depends on them "
                f"(available: {', '.join(available_lenses(None))})")
        if unknown:
            # project lenses can't be checked before the root exists; init validates them
            print(f"NOTE: lens(es) {', '.join(unknown)} are not shipped lenses; init will look in "
                  "<review-dir>/lenses/")
        d = decide(targets, lenses)
        setup_rec.update(row=d["row"], row5_eligible=row5_eligible(targets))
        setup = d["setup"] if a.setup == "auto" else a.setup
        print(f"SETUP: {setup} (decision row {d['row']}: {d['reason']})")
        if a.setup == "auto" and d["ask"]:
            opts = {1: [], 2: ["workspace"], 4: ["in-place (after the user's work is committed)", "workspace"],
                    5: ["init", "workspace"]}.get(d["row"], [])
            print(f"NEEDS DECISION: {d['reason']}. Ask the user, then re-run with one of: "
                  + ", ".join(f"--setup {o}" for o in opts))
            sys.exit(2)
        if setup == "in-place":
            tops = {git_top(t) for t in targets}
            if len(tops) != 1 or None in tops:
                die("in-place needs every target inside one git repository; use --setup workspace", 2)
            top = tops.pop()
            if any(is_ignored(top, t) for t in targets):
                die("a target is git-ignored, so in-place can't track it; use --setup workspace", 2)
            ctx = Ctx(a, root=top)
            if a.repo and Path(a.repo).expanduser().resolve() != top:
                print(f"NOTE: using the target's repository {top}, not --repo {a.repo}")
            tin = [os.path.relpath(t, top) for t in targets]
        elif setup == "init":
            if len(targets) != 1 or not targets[0].is_dir() or git_top(targets[0]):
                die("init needs a single target directory that is not in git", 2)
            init_in_place(targets[0], c)
            ctx = Ctx(a, root=targets[0])
            tin = ["."]
        else:
            ws, tin, rin, mapping = make_workspace(a, c, targets, refs, load_defaults())
            ctx = Ctx(a, root=ws)
            setup_rec.update(setup="workspace", targets=tin, refs=rin)
        setup_rec["setup"] = setup

    # review dir scaffolding (every run: the excludes may predate this version)
    created = []
    ensure_excluded(ctx.root, [".opencode/", ".delegate/"])
    if not (ctx.rdir / "config.json").exists():
        ctx.rdir.mkdir(parents=True, exist_ok=True)
        (ctx.rdir / "config.json").write_text(json.dumps({"review_loop": 1}, indent=2) + "\n")
        (ctx.rdir / "README.md").write_text((TEMPLATES / "README.md").read_text())
        (ctx.rdir / "PROJECT.md").write_text((TEMPLATES / "PROJECT.md").read_text())
        created += ["config.json", "README.md", "PROJECT.md"]
    d = ctx.cdir(c)
    if (d / "STATE.json").exists():
        die(f"cycle {c} already exists")
    d.mkdir(parents=True, exist_ok=True)

    # references for in-place/init setups
    if setup_rec["setup"] != "workspace":
        rin, taken = [], set()
        for p in refs:
            try:
                rin.append(str(p.relative_to(ctx.root)))
                mapping.append({"role": "ref", "original": str(p), "in_tree": rin[-1],
                                "kind": "dir" if p.is_dir() else "file"})
                continue
            except ValueError:
                pass
            if not ctx.ignored(".delegate/ref"):
                die("can't copy references into .delegate/ref: it is not git-ignored here "
                    "(a .gitignore rule may re-include it); they would be committed", 3)
            rel = f".delegate/ref/{c}/{unique_name(taken, p.name)}"
            skipped = []
            copy_input(p, ctx.root / rel, {}, rel, skipped)
            for x in skipped:
                print(f"  skipped {x}")
            rin.append(rel)
            mapping.append({"role": "ref", "original": str(p), "in_tree": rel,
                            "kind": "dir" if p.is_dir() else "file"})
        for t, rel in zip(targets, tin):
            mapping.append({"role": "target", "original": str(t), "in_tree": rel,
                            "kind": "dir" if t.is_dir() else "file"})
        setup_rec.update(targets=tin, refs=rin)
    setup_rec.update(root=str(ctx.root), mapping=mapping)
    if targets or refs:
        (d / "SETUP.json").write_text(json.dumps(setup_rec, indent=2) + "\n")

    bp = d / "BRIEF.md"
    if not bp.exists():
        bp.write_text((TEMPLATES / "BRIEF.md").read_text()
                      .replace("{cycle}", c)
                      .replace("{available}", ", ".join(available_lenses(ctx.rdir)))
                      .replace("{lenses}", ", ".join(lenses) if lenses else "TODO"))
        created.append(f"cycles/{c}/BRIEF.md")
    print(f"ROOT: {ctx.root}")
    print(f"REVIEW DIR: {ctx.rdir}")
    for x in created:
        print(f"  created {x}")
    if setup_rec.get("targets") or setup_rec.get("refs"):
        print("IN TREE: targets " + (", ".join(setup_rec.get("targets") or []) or "—")
              + "; references " + (", ".join(setup_rec.get("refs") or []) or "—"))
    todo = [p for p in (ctx.rdir / "PROJECT.md", bp) if has_todo(read(p))]
    repo = f" --repo {shlex.quote(str(ctx.root))}" if targets else ""
    print("NEXT: fill in every TODO in " + " and ".join(ctx.rel(p) for p in todo)
          + f", then: review-loop{repo} init {c}" if todo else f"NEXT: review-loop{repo} init {c}")


# ---------------------------------------------------------------- extraction

def expand(ctx: Ctx, rel: str) -> list:
    full = ctx.root / rel
    if full.is_file():
        return [rel]
    if not full.is_dir():
        return []
    if rel == ".delegate" or rel.startswith(".delegate/"):
        out = []
        for dp, dns, fns in os.walk(full):
            out += [os.path.relpath(Path(dp) / f, ctx.root) for f in fns]
        return sorted(out)
    # tracked plus untracked-but-not-ignored: at `respond` the builder's new files
    # aren't committed yet; files deleted from the tree are dropped
    r = ctx.git("ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", rel, check=False)
    return sorted({p for p in r.split("\0") if p and (ctx.root / p).is_file()})


def refresh_extracts(ctx: Ctx, s: dict) -> list:
    """Re-render binary targets/refs to <review-dir>/extract/<path>.md. -> warnings"""
    rels = list(s.get("targets") or []) + list(s.get("refs") or [])
    if not rels:
        return []
    lib = delegate_lib()
    if not lib:
        return ["delegate-extract not found (not on PATH, no sibling delegate/lib): "
                "binary files were not rendered as text"]
    ex = lib[0]
    rd = ctx.rel(ctx.rdir)
    files = []
    for r in rels:
        files += [f for f in expand(ctx, r) if not f.startswith(rd + "/")]
    cap = ctx.cfg.get("extract_max_mb", 25) * 1024 * 1024
    want, warns = [], []
    for f in files:
        p = ctx.root / f
        if not ex.needs_extract(p):
            continue
        if p.stat().st_size > cap:
            warns.append(f"{f}: skipped, larger than extract_max_mb")
            continue
        want.append(f)
    out_dir = ctx.rdir / "extract"
    results = ex.extract_many([ctx.root / f for f in want]) if want else {}
    keep = set()
    for f in want:
        r = results[str(ctx.root / f)]
        dest = out_dir / (f + ".md")
        keep.add(dest.resolve())
        if isinstance(r, ex.ExtractError):
            warns.append(f"{f}: {r}")
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(r.render(f))
        warns += [f"{f}: {w}" for w in r.warnings]
    if out_dir.exists():
        for p in sorted(out_dir.rglob("*"), reverse=True):
            if p.is_file() and p.resolve() not in keep:
                p.unlink()
            elif p.is_dir() and not any(p.iterdir()):
                p.rmdir()
    return warns


def extract_list(ctx: Ctx) -> list:
    d = ctx.rdir / "extract"
    return sorted(ctx.rel(p) for p in d.rglob("*.md")) if d.exists() else []


# ---------------------------------------------------------------- commands

def cmd_init(ctx: Ctx, a):
    c = a.cycle
    d = ctx.cdir(c)
    bp = d / "BRIEF.md"
    if not bp.exists():
        die(f"no brief: run review-loop new {c} and fill it in")
    if (d / "STATE.json").exists():
        die(f"cycle {c} is already open")
    brief = bp.read_text()
    heads = [h.lower() for h in re.findall(r"^## (.+)$", brief, re.M)]
    missing = [k for k in REQUIRED_BRIEF if not any(k in h for h in heads)]
    problems = []
    if missing:
        problems.append("BRIEF.md is missing sections about: " + ", ".join(missing))
    if has_todo(brief):
        problems.append("BRIEF.md still has TODO placeholders")
    lenses, legacy = brief_lenses(brief)
    if lenses is None:
        problems.append("BRIEF.md needs a line '**Lenses:** <lens>[, <lens>…]' (or the legacy "
                        "'**Type:** code|plan|other')")
    else:
        bad = [x for x in lenses if not load_lens(x, ctx.rdir)]
        if bad:
            problems.append(f"unknown lens(es): {', '.join(bad)}; available: "
                            + ", ".join(available_lenses(ctx.rdir)))
    if has_todo(read(ctx.rdir / "PROJECT.md")):
        problems.append(f"{ctx.rel(ctx.rdir / 'PROJECT.md')} still has TODO placeholders")
    setup = json.loads(read(d / "SETUP.json") or "{}")
    if lenses and setup.get("row") in (5, 6) and setup.get("row5_eligible"):
        now_cp = bool(set(lenses) & {"code", "plan"})
        if (setup["row"] == 5) != now_cp:
            problems.append("the brief's lenses no longer match the setup chosen at `new` "
                            f"(row {setup['row']}: {'needs' if setup['row'] == 5 else 'excludes'} a "
                            "code or plan lens); re-run `review-loop new` with the new lenses")
    if problems:
        die("; ".join(problems))
    if ctx.current.exists():
        cur = ctx.current.read_text().strip()
        if cur and cur != c and (ctx.cdir(cur) / "STATE.json").exists() \
                and ctx.load(cur)["status"] == "active" and not a.force:
            die(f"cycle {cur} is still active; close it first (or pass --force to run both)")
    prefix = ctx.rel(ctx.rdir) + "/"
    dirty = ctx.dirty_outside(prefix)
    if dirty:
        die(f"{len(dirty)} uncommitted change(s) outside {prefix}: the reviewer reviews committed "
            "work, and the per-round diffs need a clean start. Ask the user before committing "
            "their work. First few: " + ", ".join(dirty[:8]), 3)
    if not ctx.git("config", "user.email", check=False).strip():
        die("git has no user.email configured here; commits would fail", 3)
    cfg = ctx.cfg
    s = {"cycle": c, "status": "active", "turn": "reviewer", "iteration": 1,
         "max_iterations": a.max or cfg["max_iterations"],
         "reviewer_model": a.reviewer or cfg["reviewer_model"],
         "cycle_budget_usd": a.budget if a.budget is not None else cfg["cycle_budget_usd"],
         "round_budget_usd": cfg["round_budget_usd"],
         "round_timeout_min": cfg["round_timeout_min"],
         "lenses": lenses, "categories": compute_categories(lenses, legacy, ctx.rdir, cfg),
         "setup": setup.get("setup", "in-place"),
         "targets": setup.get("targets", []), "refs": setup.get("refs", []),
         "spent_usd": 0.0, "opened_at": now(), "base_commit": ctx.head(),
         "commit_trailer": ctx.trailer,
         "history": [{"event": "open", "at": now()}]}
    warns = refresh_extracts(ctx, s)
    ctx.idir(c, 1).mkdir(parents=True, exist_ok=True)
    ctx.save(c, s)
    ctx.current.write_text(c + "\n")
    err = ctx.commit([ctx.rel(ctx.rdir)], f"review({c}): open cycle")
    if err:
        die(f"git commit failed: {err}", 1)
    print(f"OPENED {c}: reviewer={s['reviewer_model']} max={s['max_iterations']} iterations "
          f"budget=${s['cycle_budget_usd']:.2f} base={s['base_commit'][:10]} "
          f"lenses={', '.join(lenses)} setup={s['setup']}")
    for w in warns:
        print(f"  extract warning: {w}")
    if extract_list(ctx):
        print(f"  text renditions: {len(extract_list(ctx))} file(s) under {ctx.rel(ctx.rdir / 'extract')}/")
    print("NEXT: review-loop review   (runs the reviewer; can take up to "
          f"{s['round_timeout_min']} min, so run it in the background)")


def run_reviewer(ctx: Ctx, s: dict, prompt_path: Path, out: Path, model: str, cap: float,
                 session: str | None = None, fix_prompt: str | None = None):
    """-> (exit_code, cost, session_id, message)"""
    override = os.environ.get("REVIEW_LOOP_REVIEWER")
    if override:           # test hook: a fake reviewer, called as CMD PROMPT_FILE OUT_FILE
        cmd = shlex.split(override) + [str(prompt_path), str(out)]
    else:
        cmd = ["delegate-agent", "--mode", "plan", "--dir", str(ctx.root), "--out", str(out),
               "--bare", "--model", model, "--max-cost", f"{cap:.4f}",
               "--timeout", str(s["round_timeout_min"]),
               "--title", f"review: {s['cycle']} iter {s['iteration']:02d}"]
        if session:
            cmd += ["--session", session, "--prompt", fix_prompt]
        else:
            cmd += ["--prompt-file", str(prompt_path)]
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=ctx.root)
    both = r.stdout + "\n" + r.stderr
    cost = sum(float(x) for x in re.findall(r"\bcost[= ]\$([\d.]+)", both)[:1])
    sid = (re.findall(r"session[= ](ses_\w+)", both) or [None])[0]
    msg = (r.stderr.strip().splitlines() or r.stdout.strip().splitlines() or [""])[-1]
    return r.returncode, cost, sid, msg


def lens_block(ctx: Ctx, lenses: list) -> str:
    parts = []
    for name in lenses:
        lens = load_lens(name, ctx.rdir)
        body = lens[1] if lens else "(lens file not found; use the brief's intent and checklist)"
        parts.append(f"### Lens: {name}\n\n{body}")
    return "\n\n".join(parts)


def build_prompt(ctx: Ctx, s: dict) -> str:
    c, n = s["cycle"], s["iteration"]
    cats = ", ".join(f"`{x}`" for x in cycle_categories(ctx, s))
    proto = ((TEMPLATES / "reviewer-protocol.md").read_text()
             .replace("{categories}", cats)
             .replace("{lenses}", lens_block(ctx, cycle_lenses(ctx, s))))
    parts = [proto, "---\n\n# Project notes\n\n" + read(ctx.rdir / "PROJECT.md"),
             "---\n\n# Brief for this cycle\n\n" + read(ctx.cdir(c) / "BRIEF.md")]
    rd = ctx.rel(ctx.rdir)
    excl = " ".join(shlex.quote(x) for x in ctx.diff_excludes())
    now_part = [f"---\n\n# This round\n\n- **Cycle:** `{c}`",
                f"- **Iteration:** {n:02d} (at most {s['max_iterations']})",
                f"- **Repository root:** `{ctx.root}` (your working directory)",
                f"- **Commit when the cycle opened:** `{s['base_commit']}`",
                f"- **Review records:** `{rd}/`. Earlier rounds are in "
                f"`{rd}/cycles/{c}/iter-*/`; you may read them."]
    if s.get("targets"):
        now_part.append("- **Under review (paths in this repository):** "
                        + ", ".join(f"`{t}`" for t in s["targets"]))
    if s.get("refs"):
        now_part.append("- **Reference material (read, don't review):** "
                        + ", ".join(f"`{t}`" for t in s["refs"]))
    ex = extract_list(ctx)
    if ex:
        now_part.append(f"- **Text renditions of binary files:** under `{rd}/extract/`, one "
                        "`<original path>.md` per file. Read these instead of the binaries: "
                        + ", ".join(f"`{x}`" for x in ex[:40]) + (" …" if len(ex) > 40 else ""))
    if n == 1:
        now_part.append("\nThis is the **first round**. Review the work the brief describes.")
    else:
        resp = [h for h in s["history"] if h["event"] == "response" and h["iteration"] == n - 1][-1]
        rng = f"{resp['review_commit'][:12]}..{resp['commit'][:12]}" if resp.get("commit") else None
        if rng:
            stat = ctx.git("diff", "--stat", rng, *ctx.diff_excludes(), check=False).strip()
            now_part.append(f"\n**The builder's changes since your last review:** "
                            f"`git diff {rng} {excl}`\n\n```\n{stat or '(no changes)'}\n```")
        fs = ledger(ctx, c, n - 1)
        verify = [f for f in fs.values() if f["status"] == "fix-pending"]
        if verify:
            now_part.append("\n## Verify these (one `V-` item each)\n")
            now_part += [f"- **{f['id']}** · {f['sev']} · {f['cat']} (builder: {f['last_verdict']}): {f['title']}"
                         for f in verify]
        rows = [f"| {f['id']} | {f['sev']} | {f['cat']} | {f['status']} | {f['title'].replace('|', '/')} |"
                for f in fs.values()]
        if rows:
            now_part.append("\n## Findings ledger so far (don't re-raise settled items)\n\n"
                            "| id | severity | category | status | finding |\n|---|---|---|---|---|\n"
                            + "\n".join(rows))
        now_part.append(f"\n## Your review from iteration {n - 1:02d}\n\n"
                        + read(ctx.idir(c, n - 1) / "review.md"))
        now_part.append(f"\n## The builder's response to iteration {n - 1:02d}\n\n"
                        + read(ctx.idir(c, n - 1) / "response.md"))
    now_part.append(f"\n---\n\nNow do the review for iteration {n:02d}. Your **final message** must be "
                    "the complete review in the exact format above, starting with "
                    f"`# Review — {c} — iteration {n:02d}`. Don't write it to a file.")
    parts.append("\n".join(now_part))
    return "\n\n".join(parts) + "\n"


def cmd_review(ctx: Ctx, a):
    c = ctx.cycle_name(a.cycle)
    s = ctx.load(c)
    ctx.trailer = ctx.trailer or s.get("commit_trailer")
    if s["status"] != "active":
        die(f"cycle {c} is closed ({s['status']})")
    if s["turn"] != "reviewer":
        die(f"it is the builder's turn (iteration {s['iteration']}): write response.md, then review-loop respond")
    n = s["iteration"]
    prefix = ctx.rel(ctx.cdir(c)) + "/"
    dirty = ctx.dirty_outside(prefix)
    if dirty:
        die(f"uncommitted changes outside {prefix}: " + ", ".join(dirty[:8])
            + ". Hand over through `review-loop respond` (which commits), or discard them.", 3)
    remaining = s["cycle_budget_usd"] - s["spent_usd"]
    if remaining < 0.02:
        die(f"cycle budget spent ({usd(s['spent_usd'])} of ${s['cycle_budget_usd']:.2f}). "
            "Tell the user; either close with 'Outcome: budget-reached' or, with their approval, "
            "review-loop adjust --budget N", 8)
    model = a.model or s["reviewer_model"]
    cats = cycle_categories(ctx, s)
    it = ctx.idir(c, n)
    it.mkdir(parents=True, exist_ok=True)
    prompt_path = it / "reviewer-prompt.md"
    prompt_path.write_text(build_prompt(ctx, s))
    out = it / "review.md"
    must_verify = {f["id"] for f in ledger(ctx, c, n - 1).values() if f["status"] == "fix-pending"}

    cap = min(s["round_budget_usd"], remaining)
    print(f"REVIEWING {c} iteration {n:02d} with {model} (round cap ${cap:.2f}, "
          f"timeout {s['round_timeout_min']} min)…", flush=True)
    rc, cost, sid, msg = run_reviewer(ctx, s, prompt_path, out, model, cap)
    total_cost, attempts = cost, 1
    problems = []
    if rc == 0:
        problems = validate_review(read(out), n, must_verify, cats)[0]
        while problems and attempts <= ctx.cfg["format_retries"] and sid:
            fix = ("Your review failed the automatic format check:\n- " + "\n- ".join(problems)
                   + "\n\nReply with the COMPLETE corrected review (every section), in the exact format "
                   "from the protocol. Change only what is needed to fix these problems.")
            rc, cost, sid2, msg = run_reviewer(ctx, s, prompt_path, out, model,
                                               max(0.05, min(cap, remaining - total_cost)), sid, fix)
            total_cost += cost
            attempts += 1
            if rc != 0:
                break
            problems = validate_review(read(out), n, must_verify, cats)[0]

    s["spent_usd"] = round(s["spent_usd"] + total_cost, 6)
    touched = ctx.dirty_outside(prefix)
    if touched:
        s["history"].append({"event": "review-failed", "iteration": n, "at": now(), "exit": 3,
                             "error": "reviewer changed files: " + ", ".join(touched[:10]),
                             "cost_usd": total_cost, "model": model, "session": sid})
        ctx.save(c, s)
        print(f"REVIEW REJECTED: the reviewer changed {len(touched)} file(s) outside its folder "
              "(it must be read-only):")
        for p in touched[:20]:
            print(f"  {p}")
        print("NEXT: tell the user. Inspect with `git status` / `git diff`, restore with "
              "`git checkout -- <paths>` and remove stray untracked files (only the ones listed), "
              "then retry review-loop review")
        sys.exit(3)
    if rc != 0 or problems:
        code = rc if rc != 0 else 9
        why = EXIT_MEANING.get(rc, f"exit {rc}") if rc != 0 else "review format still invalid"
        detail = msg if rc != 0 else "; ".join(problems)
        s["history"].append({"event": "review-failed", "iteration": n, "at": now(), "exit": code,
                             "error": detail[:300], "cost_usd": total_cost, "attempts": attempts,
                             "model": model, "session": sid})
        ctx.save(c, s)
        print(f"REVIEW FAILED: {why}. {detail}")
        print(f"  cost this attempt ${total_cost:.4f}; cycle {usd(s['spent_usd'])} of ${s['cycle_budget_usd']:.2f}")
        if code == 9:
            print(f"  the raw output is at {ctx.rel(out)}")
        print("NEXT: tell the user. Options: retry (review-loop review), another model "
              "(review-loop review --model <alias>), or close: write CLOSE.md with "
              "'Outcome: aborted' and run review-loop respond --decision close")
        sys.exit(code)

    text = read(out)
    _, fs, cs, vs, rec = validate_review(text, n, must_verify, cats)
    counts = {sev: sum(1 for f in fs if f[2] == sev) for sev in SEVERITIES}
    vcount = {st: sum(1 for v in vs if v[3] == st) for st in V_STATUSES}
    s["history"].append({"event": "review", "iteration": n, "at": now(), "counts": counts,
                         "challenges": len(cs), "verifications": vcount, "recommendation": rec,
                         "cost_usd": total_cost, "attempts": attempts, "model": model, "session": sid})
    s["turn"] = "builder"
    ctx.save(c, s)
    summary = ", ".join(f"{v} {k}" for k, v in counts.items() if v) or "no new findings"
    err = ctx.commit([ctx.rel(ctx.cdir(c))], f"review({c}): iter {n:02d} review — {summary}; recommend {rec}")
    if err:
        s["turn"] = "reviewer"
        s["history"].pop()
        ctx.save(c, s)
        die(f"git commit failed, so the turn was not handed over: {err}", 1)

    reopened = [v for v in vs if v[3] != "verified"]
    print(f"REVIEWED {c} iteration {n:02d}: {summary}; {len(cs)} challenge(s); "
          f"{vcount['verified']} verified, {len(reopened)} not verified; recommend {rec}")
    for fid, _it, sev, cat in fs:
        print(f"  {fid} · {sev} · {cat}: {finding_title(text, fid)}")
    for vid, _it, ref, st in reopened:
        print(f"  {vid} · {ref} · {st}")
    for cid, _it, ref in cs:
        print(f"  {cid} · challenges {ref}")
    print(f"  cost ${total_cost:.4f} (cycle {usd(s['spent_usd'])} of ${s['cycle_budget_usd']:.2f}) · "
          f"file {ctx.rel(out)}")
    need = [f[0] for f in fs] + [x[0] for x in cs] + [v[2] for v in reopened]
    if need:
        print(f"NEXT: verify each item yourself, fix what holds up, run the checks, write "
              f"{ctx.rel(it / 'response.md')} with a verdict for: {', '.join(need)}; "
              "then review-loop respond --decision continue (or close)")
    else:
        print(f"NEXT: nothing to answer. If converging, write CLOSE.md ('Outcome: converged') and "
              f"{ctx.rel(it / 'response.md')} (a summary), then review-loop respond --decision close")


def cmd_respond(ctx: Ctx, a):
    c = ctx.cycle_name(a.cycle)
    s = ctx.load(c)
    ctx.trailer = ctx.trailer or s.get("commit_trailer")
    if s["status"] != "active":
        die(f"cycle {c} is closed ({s['status']})")
    n = s["iteration"]
    it = ctx.idir(c, n)
    cp = ctx.cdir(c) / "CLOSE.md"

    outcome = None
    if a.decision == "close":
        if not cp.exists():
            die(f"write {ctx.rel(cp)} first (see the skill for its format)")
        m = OUTCOME.search(cp.read_text())
        if not m:
            die("CLOSE.md needs a line 'Outcome: converged|cap-reached|budget-reached|aborted'")
        outcome = m.group(1)

    if s["turn"] == "reviewer":
        # no review to answer: only an early stop is possible
        if a.decision != "close" or outcome not in ("aborted", "budget-reached", "cap-reached"):
            die("it is the reviewer's turn: run review-loop review, or close early with "
                "Outcome: aborted / budget-reached")
        verdicts, need = {}, []
    else:
        rp, resp = it / "review.md", it / "response.md"
        if not resp.exists():
            die(f"{ctx.rel(resp)} does not exist")
        rtext, ptext = read(rp), resp.read_text()
        need = {x[0] for x in F_HDR.findall(rtext)} | {x[0] for x in C_HDR.findall(rtext)} \
            | {v[2] for v in V_HDR.findall(rtext) if v[3] != "verified"}
        answered = {x[0] for x in R_HDR.findall(ptext)}
        missing = sorted(need - answered)
        if missing:
            die("response.md has no verdict for: " + ", ".join(missing)
                + " (headings: '### F-NN-MM · ACCEPT|REJECT|PARTIAL|BACKLOG')")
        verdicts = {v: 0 for v in VERDICTS}
        for _id, v in R_HDR.findall(ptext):
            verdicts[v] += 1
        if a.decision == "continue" and n >= s["max_iterations"]:
            die(f"iteration cap ({s['max_iterations']}) reached: write CLOSE.md with "
                "'Outcome: cap-reached' and close; tell the user what is still open", 8)

    if outcome == "converged":
        fs = ledger(ctx, c, n)
        last = [h for h in s["history"] if h["event"] == "review"]
        rec = last[-1]["recommendation"] if last else None
        unverified = [f["id"] for f in fs.values()
                      if f["sev"] in ("blocker", "major") and f["status"] not in
                      ("verified", "rejected", "backlog", "disputed")]
        blockers = []
        if unverified:
            blockers.append("blocker/major findings not verified by the reviewer: " + ", ".join(unverified))
        if rec != "converge":
            blockers.append(f"the reviewer's last recommendation was '{rec}'")
        if blockers and not a.override:
            die("; ".join(blockers) + ". Run another round (--decision continue), or if the user "
                "agrees, pass --override 'reason' (and say why in CLOSE.md)")

    warns = refresh_extracts(ctx, s)
    head_before = ctx.head()
    ev = {"event": "response", "iteration": n, "at": now(), "verdicts": verdicts,
          "decision": a.decision, "review_commit": head_before}
    if a.override:
        ev["override"] = a.override
    s["history"].append(ev)
    if a.decision == "close":
        s["status"], s["turn"] = outcome, "none"
    else:
        s["iteration"], s["turn"] = n + 1, "reviewer"
        ctx.idir(c, n + 1).mkdir(exist_ok=True)
    ctx.save(c, s)
    close_before = read(cp) if a.decision == "close" else None
    if a.decision == "close":
        write_round_summary(cp, s)
    summary = ", ".join(f"{v} {k.lower()}" for k, v in verdicts.items() if v) or "no verdicts"
    label = f"iter {n:02d} response — {summary}" + (f"; close: {outcome}" if outcome else "")
    err = ctx.commit([], f"review({c}): {label}")
    if err:
        s["history"].pop()
        if a.decision == "close":
            s["status"], s["turn"] = "active", ("builder" if verdicts or need else "reviewer")
            cp.write_text(close_before)
        else:
            s["iteration"], s["turn"] = n, "builder"
        ctx.save(c, s)
        die(f"git commit failed, so nothing was handed over: {err}", 1)
    for w in warns:
        print(f"  extract warning: {w}")
    if a.decision == "continue":
        # the next round's diff range; saved now, committed with the next hand-over
        ev["commit"] = ctx.head()
        ctx.save(c, s)
    if a.decision == "close":
        fs = ledger(ctx, c, n)
        by = {}
        for f in fs.values():
            by[f["status"]] = by.get(f["status"], 0) + 1
        print(f"CLOSED {c}: {outcome} after {n} iteration(s); {len(fs)} finding(s) "
              f"({', '.join(f'{v} {k}' for k, v in by.items()) or 'none'}); "
              f"reviewer spend {usd(s['spent_usd'])}")
        print(round_summary(s))
        nxt = f"NEXT: report to the user from {ctx.rel(cp)}: outcome, round summary, what changed, open disputes, backlog"
        if s.get("setup") == "workspace":
            nxt += ("; then offer to copy the changes back (review-loop apply shows the plan; "
                    "apply --yes only with the user's approval)")
        print(nxt)
    else:
        print(f"HANDED OVER {c} iteration {n:02d} ({summary}). Reviewer's turn: iteration {n + 1:02d}.")
        print("NEXT: review-loop review")


def cmd_status(ctx: Ctx, a):
    c = ctx.cycle_name(a.cycle)
    s = ctx.load(c)
    print(f"{c}: {s['status']} · turn={s['turn']} · iteration {s['iteration']}/{s['max_iterations']} · "
          f"reviewer={s['reviewer_model']} · spent {usd(s['spent_usd'])} of ${s['cycle_budget_usd']:.2f}")
    print(f"  lenses: {', '.join(cycle_lenses(ctx, s))} · setup: {s.get('setup', 'in-place')}")
    for h in s["history"][-6:]:
        extra = {k: v for k, v in h.items() if k not in ("event", "at", "session", "review_commit", "commit")}
        print(f"  {h['at'][:16]} {h['event']:<14} {json.dumps(extra)[:150]}")
    fs = ledger(ctx, c, s["iteration"])
    if fs:
        by = {}
        for f in fs.values():
            by[f["status"]] = by.get(f["status"], 0) + 1
        print("  findings: " + ", ".join(f"{v} {k}" for k, v in by.items()))
    print()
    print(round_summary(s))
    print()
    if s["status"] != "active":
        print(f"NEXT: closed. See {ctx.rel(ctx.cdir(c) / 'CLOSE.md')}")
    elif s["turn"] == "reviewer":
        print("NEXT: review-loop review")
    else:
        print(f"NEXT: write {ctx.rel(ctx.idir(c, s['iteration']) / 'response.md')}, then review-loop respond")


def cmd_ledger(ctx: Ctx, a):
    c = ctx.cycle_name(a.cycle)
    s = ctx.load(c)
    fs = ledger(ctx, c, s["iteration"])
    if not fs:
        print("no findings yet")
    for f in fs.values():
        print(f"{f['id']} · {f['sev']:<7} · {f['cat']:<16} · {f['status']:<11} · {f['title']}")


def cmd_changes(ctx: Ctx, a):
    c = ctx.cycle_name(a.cycle)
    s = ctx.load(c)
    resps = [h for h in s["history"] if h["event"] == "response" and h.get("commit")]
    if a.iteration:
        resps = [h for h in resps if h["iteration"] == a.iteration]
    if not resps:
        print(f"no builder changes yet; the cycle opened at {s['base_commit'][:12]}")
        return
    h = resps[-1]
    rng = f"{h['review_commit'][:12]}..{h['commit'][:12]}"
    print(f"builder changes in iteration {h['iteration']:02d}: {rng}")
    print(ctx.git("diff", "--stat", rng, *ctx.diff_excludes(), check=False))
    print(f"full diff: git diff {rng} " + " ".join(shlex.quote(x) for x in ctx.diff_excludes()))


def cmd_list(ctx: Ctx, a):
    if not ctx.cycles.exists():
        print(f"no cycles under {ctx.rdir}")
        return
    cur = read(ctx.current).strip()
    for d in sorted(ctx.cycles.iterdir()):
        sp = d / "STATE.json"
        if sp.exists():
            s = json.loads(sp.read_text())
            print(f"{'*' if d.name == cur else ' '} {d.name:<40} {s['status']:<14} "
                  f"iter {s['iteration']}/{s['max_iterations']}  {usd(s['spent_usd'])}")
        else:
            print(f"  {d.name:<40} (brief only)")


def cmd_lenses(a):
    rdir = None
    if a.repo or run_git(Path.cwd(), "rev-parse", "--show-toplevel").returncode == 0:
        try:
            rdir = Ctx(a).rdir
        except SystemExit:
            rdir = None
    for name in available_lenses(rdir):
        cats, body = load_lens(name, rdir)
        first = body.splitlines()[0].lstrip("- ").strip() if body else ""
        print(f"{name:<13} categories: {', '.join(cats) or '(core only)'}")
        print(f"{'':<13} {first[:100]}")


def cmd_adjust(ctx: Ctx, a):
    c = ctx.cycle_name(a.cycle)
    s = ctx.load(c)
    if s["status"] != "active":
        die(f"cycle {c} is closed")
    changed = {}
    if a.budget is not None:
        s["cycle_budget_usd"] = changed["cycle_budget_usd"] = a.budget
    if a.max is not None:
        s["max_iterations"] = changed["max_iterations"] = a.max
    if a.model:
        s["reviewer_model"] = changed["reviewer_model"] = a.model
    if a.round_budget is not None:
        s["round_budget_usd"] = changed["round_budget_usd"] = a.round_budget
    if a.timeout is not None:
        s["round_timeout_min"] = changed["round_timeout_min"] = a.timeout
    if not changed:
        die("nothing to change")
    s["history"].append({"event": "adjust", "at": now(), **changed})
    ctx.save(c, s)
    print(f"ADJUSTED {c}: " + ", ".join(f"{k}={v}" for k, v in changed.items()))


def cmd_apply(ctx: Ctx, a):
    sp = ctx.root / "SOURCES.json"
    if not sp.exists():
        die("apply works in workspace cycles only (no SOURCES.json here); in-place cycles already "
            "edit the originals")
    src = json.loads(sp.read_text())
    snap = src["files"]
    plan, conflicts, skipped = [], [], []
    for inp in (i for i in src["inputs"] if i["role"] == "target"):
        name, orig, kind = inp["in_tree"], Path(inp["original"]), inp["kind"]
        now_files = {}
        base = ctx.root / name
        if kind == "file":
            if base.exists():
                now_files[name] = base
        elif base.exists():
            for dp, dns, fns in os.walk(base):
                dns[:] = [d for d in dns if d not in COPY_SKIP]
                for fn in fns:
                    if fn in COPY_SKIP:
                        continue
                    p = Path(dp) / fn
                    now_files[f"{name}/{p.relative_to(base).as_posix()}"] = p
        mine = {k: v for k, v in snap.items() if k == name or k.startswith(name + "/")}
        for rel, p in sorted(now_files.items()):
            if rel in mine:
                ent = mine[rel]
                if sha256(p) == ent["sha256"]:
                    continue
                o = Path(ent["original"])
                if not o.exists() or sha256(o) != ent["sha256"]:
                    conflicts.append(f"modified: {rel} -> {o} (the original changed or is gone since the copy)")
                else:
                    plan.append(("modify", p, o))
            else:                       # only possible under a directory input
                dest = orig / Path(rel).relative_to(name)
                if dest.exists():
                    conflicts.append(f"new: {rel} -> {dest} (the destination already exists)")
                elif not a.include_new:
                    skipped.append(f"new file {rel} -> {dest} (pass --include-new)")
                else:
                    plan.append(("create", p, dest))
        for rel, ent in sorted(mine.items()):
            if rel in now_files:
                continue
            o = Path(ent["original"])
            if not o.exists() or sha256(o) != ent["sha256"]:
                conflicts.append(f"deleted: {rel} -> {o} (the original changed or is gone since the copy)")
            elif not a.include_deletes:
                skipped.append(f"deleted {rel} -> would delete {o} (pass --include-deletes)")
            else:
                plan.append(("delete", None, o))
    for kind, p, dest in plan:
        print(f"{'APPLY' if a.yes else 'WOULD'} {kind:<6} {dest}")
        if a.yes:
            if kind == "delete":
                dest.unlink()
            else:
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(p, dest)
    for x in skipped:
        print(f"SKIP   {x}")
    for x in conflicts:
        print(f"CONFLICT {x}")
    if not plan and not conflicts:
        print("nothing to apply: the workspace matches the originals")
    if plan and not a.yes:
        print("NEXT: this was a dry run. Show the user; with their approval run review-loop apply --yes")
    if conflicts:
        print(f"{len(conflicts)} conflict(s) were not applied; resolve them by hand")
        sys.exit(3)


def main():
    ap = argparse.ArgumentParser(prog="review-loop", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo")
    ap.add_argument("--review-dir")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, cycle=True, noctx=False):
        p = sub.add_parser(name)
        if cycle:
            p.add_argument("--cycle")
        p.set_defaults(fn=fn, noctx=noctx)
        return p

    p = add("new", cmd_new, cycle=False, noctx=True); p.add_argument("cycle")
    p.add_argument("--target", action="append", help="the work under review (file or dir; repeatable)")
    p.add_argument("--ref", action="append", help="reference material, read but not reviewed (repeatable)")
    p.add_argument("--lenses", help="comma-separated review lenses, primary first (see `lenses`)")
    p.add_argument("--setup", choices=("auto",) + SETUPS, default="auto")
    p.add_argument("--workspace-root")
    p.add_argument("--force", action="store_true", help="workspace: allow inputs over workspace_max_mb")
    p = add("init", cmd_init, cycle=False); p.add_argument("cycle")
    p.add_argument("--reviewer"); p.add_argument("--max", type=int)
    p.add_argument("--budget", type=float); p.add_argument("--trailer")
    p.add_argument("--force", action="store_true")
    p = add("review", cmd_review); p.add_argument("--model")
    p = add("respond", cmd_respond)
    p.add_argument("--decision", choices=("continue", "close"), required=True)
    p.add_argument("--override"); p.add_argument("--trailer")
    add("status", cmd_status)
    add("ledger", cmd_ledger)
    p = add("changes", cmd_changes); p.add_argument("--iteration", type=int)
    add("list", cmd_list, cycle=False)
    add("lenses", cmd_lenses, cycle=False, noctx=True)
    p = add("adjust", cmd_adjust)
    p.add_argument("--budget", type=float); p.add_argument("--max", type=int)
    p.add_argument("--model"); p.add_argument("--round-budget", type=float)
    p.add_argument("--timeout", type=float)
    p = add("apply", cmd_apply, cycle=False)
    p.add_argument("--yes", action="store_true", help="perform the copy (default: dry run)")
    p.add_argument("--include-new", action="store_true")
    p.add_argument("--include-deletes", action="store_true")
    a = ap.parse_args()
    try:
        if a.noctx:
            a.fn(a)
        else:
            a.fn(Ctx(a), a)
    except KeyboardInterrupt:
        die("interrupted", 130)


if __name__ == "__main__":
    main()
