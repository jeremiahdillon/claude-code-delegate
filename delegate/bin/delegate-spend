#!/usr/bin/env python3
"""delegate-spend — summarize ~/.claude/delegate/ledger.jsonl.

  delegate-spend            last 7 days, by day / tier / model
  delegate-spend --days 30
  delegate-spend --tail 10  last N calls
"""
from __future__ import annotations

import argparse
import collections
import datetime as dt
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import delegate_common as dc  # noqa: E402


def main():
    p = argparse.ArgumentParser(prog="delegate-spend")
    p.add_argument("--days", type=int, default=7)
    p.add_argument("--tail", type=int, help="show the last N calls instead")
    a = p.parse_args()
    if not dc.LEDGER.exists():
        print("no delegated calls yet")
        return
    rows = [json.loads(l) for l in dc.LEDGER.read_text().splitlines() if l.strip()]
    if a.tail:
        for r in rows[-a.tail:]:
            status = "ok" if r.get("exit") == 0 else f"exit {r.get('exit')}"
            print(f"{r['ts'][:16]}  {r['tier']:<9} {r.get('model', ''):<38} "
                  f"{dc.fmt_cost(r.get('cost_usd')):>9}  {status:<7} {r.get('out') or r.get('error', '')[:60]}")
        return
    since = dt.datetime.now().astimezone() - dt.timedelta(days=a.days)
    rows = [r for r in rows if dt.datetime.fromisoformat(r["ts"]) >= since]
    by = collections.defaultdict(lambda: [0, 0, 0.0])
    for r in rows:
        k = (r["ts"][:10], r["tier"], r.get("model", "?"))
        by[k][0] += 1
        by[k][1] += r.get("exit") not in (0, None)
        by[k][2] += r.get("cost_usd") or 0
    total = sum(v[2] for v in by.values())
    print(f"{'day':<11} {'tier':<9} {'model':<38} {'calls':>5} {'fail':>4} {'cost':>9}")
    for (d, t, m), (n, f, c) in sorted(by.items()):
        print(f"{d:<11} {t:<9} {m:<38} {n:>5} {f:>4} {dc.fmt_cost(c):>9}")
    print(f"\ntotal last {a.days}d: {dc.fmt_cost(total)} over {len(rows)} calls")


if __name__ == "__main__":
    main()
